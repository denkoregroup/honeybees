# Shopify Storefront API (server-only; never prefix with NEXT_PUBLIC_)
# Bare store hostname, no protocol or path
SHOPIFY_STORE_DOMAIN=
# PRIVATE Storefront access token from the Headless sales channel
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Optional; defaults to the latest stable version pinned in lib/storefront/client.ts
SHOPIFY_STOREFRONT_API_VERSION=
